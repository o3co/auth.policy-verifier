{
	"about": "A user acting on their own record is the principal and the resource at once (#282). Under sharedEntity = \"merge\" the request carries one entity holding what both mappings know of it — the principal's `dept`, the resource's `owner`.",
	"config": {
		"principal": {
			"attributes": {
				"dept": "department"
			}
		},
		"resource": {
			"attributes": {
				"owner": {
					"attribute": "resourceOwner",
					"entityType": "User"
				}
			}
		},
		"sharedEntity": "merge"
	},
	"requests": [
		{
			"about": "their own record: one entity",
			"attributes": {
				"userId": "alice",
				"requestAction": "read",
