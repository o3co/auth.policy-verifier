					"principal": {
						"type": "User",
						"id": "alice"
					},
					"action": {
						"type": "Action",
						"id": "read"
					},
					"resource": {
						"type": "User",
						"id": "alice"
					},
					"context": {},
					"entities": [
						{
							"uid": {
								"type": "User",
								"id": "alice"
							},
							"attrs": {
								"dept": "eng",
								"owner": {
									"__entity": {
										"type": "User",
										"id": "alice"
									}
								}
							},
							"parents": []
						}
					]
				},
				"decision": "allow",
				"determiningPolicies": ["10-permit-own-record"],
